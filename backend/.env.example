# Include server host and port, runtime mode, frontend origin, webhook secret, and MongoDB connection settings.
NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/freelancehub

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=